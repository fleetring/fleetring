# A systemd user unit that runs a dev mode node (ADR-0039) for one user, with everything in
# ~/.fleetring. Not for production: dev mode serves loopback only, with its authority's key in its
# directory.
#
#   mkdir -p ~/.config/systemd/user
#   cp fleetring-dev.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now fleetring-dev
#   journalctl --user -u fleetring-dev       # the banner and the logs
#   fleetring status                         # the `dev` context points the commands at it
#
# Every start writes the `dev` context and makes it current unless another context is; if one is,
# `fleetring switch dev` selects it. ~/.fleetring/env is still written, for scripts.
#
# ExecStart assumes install.sh's location for a user install, ~/.local/bin; change it to
# /usr/local/bin/fleetring (install.sh as root) or /usr/bin/fleetring (a package) as needed.
[Unit]
Description=fleetring dev mode: one local node for development
Documentation=https://github.com/fleetring/fleetring/blob/main/docs/adr/0039-dev-mode.md

[Service]
ExecStart=%h/.local/bin/fleetring dev
# SIGTERM stops the node cleanly; it keeps its databases for the next start.
KillSignal=SIGTERM
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
