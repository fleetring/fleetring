<?xml version="1.0" encoding="UTF-8"?>
<!--
  The launchd agent `brew services start fleetring` installs from homebrew-service.rb: a dev
  mode node (ADR-0039) that runs at login, as the user, with everything in ~/.fleetring.

  Without Homebrew, copy it to ~/Library/LaunchAgents/, change the binary's path to where
  fleetring is installed (install.sh puts it in /usr/local/bin as root, ~/.local/bin otherwise)
  and the log paths, then run:

    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/homebrew.mxcl.fleetring.plist

  Stop it with `brew services stop fleetring` (or `launchctl bootout` for a copy without
  Homebrew); `fleetring dev stop` refuses a node launchd runs.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>homebrew.mxcl.fleetring</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/fleetring/bin/fleetring</string>
    <string>dev</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/opt/homebrew/var/log/fleetring.log</string>
  <key>StandardErrorPath</key>
  <string>/opt/homebrew/var/log/fleetring.log</string>
</dict>
</plist>
