#!/bin/sh
# Enforce Conventional Commits: type(scope)!: summary
msg_file="$1"
first_line=$(head -n1 "$msg_file")

# Allow git-generated merge, revert, fixup, and squash messages
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,72}$'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "✖ Commit message must follow Conventional Commits:" >&2
  echo "    type(scope): summary" >&2
  echo "  types: feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  e.g.  feat(ring): add bounded-load consistent hashing" >&2
  echo "  got:  $first_line" >&2
  exit 1
fi

# A Refs trailer, if present, names issues as FR-NNN or #N, comma-separated.
refs_pattern='^Refs: (FR-[0-9]{3,}|#[0-9]+)(, (FR-[0-9]{3,}|#[0-9]+))*$'
bad_refs=$(grep '^Refs:' "$msg_file" | grep -Ev "$refs_pattern" | head -n1)
if [ -n "$bad_refs" ]; then
  echo "✖ A Refs trailer lists issues as FR-NNN or #N, comma-separated:" >&2
  echo "    Refs: FR-049, #52" >&2
  echo "  got:  $bad_refs" >&2
  exit 1
fi
